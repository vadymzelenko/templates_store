# Адрес сайта без слеша в конце — из него собираются ссылки в письмах
PUBLIC_BASE_URL=http://localhost:3000
# Длинная случайная строка: openssl rand -base64 32
JWT_SECRET=
# Почта владельца (через запятую, если несколько) — входит сразу в /admin
ADMIN_EMAIL=

# Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Письма. console = ссылка печатается в лог сервера (для проверки без почты)
EMAIL_PROVIDER=nodemailer
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=Прилавок
